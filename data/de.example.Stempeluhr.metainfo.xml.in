<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>de.example.Stempeluhr</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Stempeluhr</name>
  <summary>Start and stop Kimai time tracking</summary>
  <developer id="de.example">
    <name>The Stempeluhr authors</name>
  </developer>
  <description>
    <p>Stempeluhr is a small companion for Kimai. It starts and stops time tracking and shows what is running right now, nothing more.</p>
    <p>Kimai is always the source of truth: when tracking is started or stopped somewhere else, the app notices and never shows an outdated state. If the server can’t be reached, the last known state is clearly marked as unconfirmed.</p>
    <ul>
      <li>Start and stop tracking with a project, an activity and an optional description</li>
      <li>Quick access to recently used combinations</li>
      <li>Stop from a notification, a keyboard shortcut or the command line</li>
      <li>No background process: the app only runs while its window is open</li>
    </ul>
  </description>
  <launchable type="desktop-id">de.example.Stempeluhr.desktop</launchable>
  <url type="homepage">https://example.org/stempeluhr</url>
  <url type="bugtracker">https://example.org/stempeluhr/issues</url>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <provides>
    <binary>stempeluhr</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-11-15">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
