msgstr "Verbinden …"

#: src/connect_dialog.rs:90 src/ui/connect-dialog.blp:56
msgid "Connect"
msgstr "Verbinden"

#: src/connect_dialog.rs:101
msgid "Please enter the address of your Kimai server."
msgstr "Bitte gib die Adresse deines Kimai-Servers ein."

#: src/connect_dialog.rs:102
msgid "The address must start with https:// or http://."
msgstr "Die Adresse muss mit https:// oder http:// beginnen."

#: src/connect_dialog.rs:103
msgid ""
"Don’t put a user name or password in the address. Use an API token instead."
msgstr ""
"Gib keinen Benutzernamen und kein Passwort in der Adresse an. Verwende "
"stattdessen ein API-Token."

#: src/connect_dialog.rs:104
msgid "This doesn’t look like a valid address."
msgstr "Das sieht nicht nach einer gültigen Adresse aus."

#: src/connect_dialog.rs:113
msgid "Please enter your API token."
msgstr "Bitte gib dein API-Token ein."

#: src/connect_dialog.rs:152
msgid ""
"The token couldn’t be saved to the system keyring, so it can’t be kept "
"safely."
msgstr ""
"Das Token konnte nicht im System-Schlüsselbund gespeichert werden und lässt "
"sich daher nicht sicher aufbewahren."

#: src/connect_dialog.rs:160
#, rust-format
msgid "Connected as {user}"
msgstr "Verbunden als {user}"

#: src/messages.rs:11
msgid "Can’t connect to the server. Check your internet connection."
msgstr "Keine Verbindung zum Server. Prüfe deine Internetverbindung."

#: src/messages.rs:13
msgid ""
"The server address couldn’t be found. Check the address and your internet "
"connection."
msgstr ""
"Die Serveradresse wurde nicht gefunden. Prüfe die Adresse und deine "
"Internetverbindung."

#: src/messages.rs:15
msgid "The server took too long to respond."
msgstr "Der Server antwortet zu langsam."

#: src/messages.rs:16
msgid "The server’s security certificate couldn’t be verified."
msgstr "Das Sicherheitszertifikat des Servers konnte nicht überprüft werden."

#: src/messages.rs:18
msgid "The access token was rejected. It may be invalid or revoked."
msgstr ""
"Das Zugangs-Token wurde abgelehnt. Es ist möglicherweise ungültig oder "
"widerrufen."

#: src/messages.rs:20
msgid "Nothing was found at this address. Check the server address."
msgstr "Unter dieser Adresse wurde nichts gefunden. Prüfe die Serveradresse."

#: src/messages.rs:22
#, rust-format
msgid "Kimai rejected the request: {details}"
msgstr "Kimai hat die Anfrage abgelehnt: {details}"

#: src/messages.rs:25
msgid "Kimai rejected the request."
msgstr "Kimai hat die Anfrage abgelehnt."

#: src/messages.rs:27
msgid ""
"The server redirected the request. Check the server address, preferably use "
"https://."
msgstr ""
"Der Server hat die Anfrage umgeleitet. Prüfe die Serveradresse, am besten "
"mit https://."

#: src/messages.rs:30
#, rust-format
msgid "The server reported an internal error ({code}). Try again later."
msgstr ""
"Der Server meldet einen internen Fehler ({code}). Versuche es später erneut."

#: src/messages.rs:34
#, rust-format
msgid "The server refused the request ({code})."
msgstr "Der Server hat die Anfrage abgelehnt ({code})."

#: src/messages.rs:38
msgid ""
"The server’s answer wasn’t understood. Is this the address of a Kimai server?"
msgstr ""
"Die Antwort des Servers wurde nicht verstanden. Ist das die Adresse eines "
"Kimai-Servers?"

#: src/messages.rs:40
msgid "Something went wrong while contacting the server."
msgstr "Bei der Kommunikation mit dem Server ist etwas schiefgegangen."

#: src/format.rs:45
#, rust-format
msgid "Since {time}"
msgstr "Seit {time}"

#: src/preferences.rs:65
msgid "Not connected"
msgstr "Nicht verbunden"

#: src/preferences.rs:86
msgid "Disconnect from Kimai?"
msgstr "Von Kimai trennen?"

#: src/preferences.rs:87
msgid ""
"The access token is removed from this device. Your time tracking in Kimai is "
"not affected."
msgstr ""
"Das Zugangs-Token wird von diesem Gerät entfernt. Deine Zeiterfassung in "
"Kimai bleibt unberührt."

