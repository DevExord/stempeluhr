using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Time Tracking");

    Adw.ShortcutsItem {
      title: _("Start or Stop");
      accelerator: "<Control>Return";
    }

    Adw.ShortcutsItem {
      title: _("History");
      accelerator: "<Control>h";
    }

    Adw.ShortcutsItem {
      title: _("Refresh");
      accelerator: "<Control>r F5";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Control>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Control>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>q";
    }
  }
}
